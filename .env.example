# Disable the free public cloud endpoint and use local models only.
AHUMANE_DISABLE_CLOUD=1

# Prefer Ollama when no explicit model is selected.
AHUMANE_PREFER_LOCAL=1

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Any OpenAI-compatible server (vLLM, llama.cpp server, LM Studio, etc.)
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=

# Optional: override the public cloud endpoint/model.
# OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net
# OVH_MODEL=Meta-Llama-3_3-70B-Instruct
